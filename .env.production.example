# VulnScanner Production Environment Configuration
# Copy this to .env and fill in your actual production values

# Frontend
VITE_API_URL=https://your-production-api.com

# Flask Security - CHANGE THIS TO A STRONG RANDOM SECRET
JWT_SECRET=your-very-long-random-secret-key-here-min-32-chars-change-in-production

# Shodan API Key (optional)
SHODAN_API_KEY=your-shodan-api-key-here

# Database - Use PostgreSQL for production
DATABASE_URL=postgresql://user:password@postgres-host:5432/vulnscanner

# Flask Environment
FLASK_ENV=production
FLASK_DEBUG=false

# Logging
LOG_LEVEL=INFO

# Scanner Limits
MAX_CONCURRENT_SCANS=10
SCAN_TIMEOUT=1800

# Admin Settings
REQUIRE_APPROVAL=true
WHITELIST_ENABLED=true
WHITELIST_IPS=your-ip-range-here
BLACKLIST_IPS=

# Audit Logging
AUDIT_RETENTION_DAYS=90
