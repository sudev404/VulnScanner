# VulnScanner Environment Configuration
# Copy this to .env and fill in your values

# Frontend
VITE_API_URL=http://localhost:5000

# Flask Security
JWT_SECRET=your-very-long-random-secret-key-here-min-32-chars

# Shodan API Key (optional)
SHODAN_API_KEY=your-shodan-api-key-here

# Database
DATABASE_URL=sqlite:///vulnscanner.db

# Flask Environment
FLASK_ENV=production
FLASK_DEBUG=false

# Logging
LOG_LEVEL=INFO

# Scanner Limits
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT=1800

# Admin Settings
REQUIRE_APPROVAL=false
WHITELIST_ENABLED=false
WHITELIST_IPS=192.168.0.0/16,10.0.0.0/8
BLACKLIST_IPS=8.8.8.8,1.1.1.1

# Audit
LOG_RETENTION_DAYS=90
